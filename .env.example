# 数据库连接（MySQL）
DATABASE_URL=mysql://root:your_password@localhost:3306/sheying

# JWT密钥（必须配置！生成方式: openssl rand -base64 48）
JWT_SECRET=your-strong-random-secret-here

# 运行端口
PORT=53626
